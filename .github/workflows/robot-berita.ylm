name: Robot Berita KabarKilat

on:
  schedule:
    - cron: "*/30 * * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  ambil-berita:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Ambil berita dari semua umpan
        run: python ambil-berita.py
      - name: Simpan berita.json ke repo
        run: |
          git config user.name "KabarKilat Robot"
          git config user.email "robot@kabarkilat.local"
          git add berita.json
          git diff --cached --quiet || git commit -m "Update berita otomatis"
          git push
